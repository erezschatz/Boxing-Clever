{
  "name": "boxing-clever",
  "version": "2.0.0-draft",
  "exports": "./mod.ts",
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable"
    ]
  },
  "imports": {
    "hono": "npm:hono@4",
    "zod": "npm:zod@4"
  },
  "tasks": {
    "dev": "deno serve --watch --port 8890 --allow-net --allow-read --allow-write --allow-env mod.ts",
    "test": "deno test --allow-read --allow-env tests/",
    "check": "deno check mod.ts",
    "migrate": "deno run --allow-read --allow-write --allow-env server/db/migrate.ts",
    "build": "echo 'task 06: emit front/dist' && exit 1",
    "tbrb-daily": "deno run --allow-net --allow-read --allow-write --allow-env scripts/tbrb-daily.ts",
    "hooks": "git config core.hooksPath .githooks",
    "changelog": "deno run --allow-run=git,/bin/sh --allow-read --allow-env --allow-write=CHANGELOG.md scripts/compile-changelog.mjs",
    "check-unit-test": "node --test .claude/hooks/check-unit.test.mjs"
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 100,
    "indentWidth": 2,
    "exclude": [
      "**/*.md",
      ".claude/",
      "scripts/compile-changelog.mjs"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "exclude": [
    "docs/reference",
    "data"
  ]
}
